# Server-only credentials. Paste your keys here in .env, never NEXT_PUBLIC_*.
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# Optional overrides; these defaults work without choosing models or a voice.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
